<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Revenant_Theme_Studio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>IconEngine\icons\Logos\rts_app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="IconEngine\**\*" />
    <None Remove="IconEngine\icons\Logos\rts_app.ico" />
    <Resource Include="IconEngine\icons\Logos\rts_app.ico" />
  </ItemGroup>

</Project>
