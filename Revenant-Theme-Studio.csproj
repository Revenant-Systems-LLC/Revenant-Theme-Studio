<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Revenant_Theme_Studio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\rts_app.ico</ApplicationIcon>
    <!--
      Exclude Claude Code agent scratch directories from EVERY default item
      glob (Compile, Page, Resource, ApplicationDefinition, None, Embedded-
      Resource, ...). DefaultItemExcludes is an MSBuild property — unlike
      per-item <Remove/> entries, it's inherited by WPF's MarkupCompilePass1
      _wpftmp.csproj. Without this, any leftover worktree under
      .claude\worktrees\ gets re-globbed by the WPF temp project and
      poisons the build with stale duplicates of services/views.

      Keep this here even when no worktrees are present — agent runs may
      drop new ones in at any time and this makes the project bulletproof.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.claude\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="IconEngine\**\*" />
    <None Remove="Assets\rts_app.ico" />
    <!-- Branding assets — embedded as WPF pack resources -->
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
