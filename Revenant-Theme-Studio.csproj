<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Revenant_Theme_Studio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enable auto-emission of assembly attributes (Version/Product/Company/etc.) from the
         csproj properties below. AssemblyInfo.cs keeps only the ThemeInfo + SupportedOSPlatform
         attributes, neither of which overlaps with the auto-generated set. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\rts_app.ico</ApplicationIcon>

    <!-- Ship metadata — keep in sync with Package.appxmanifest.template <Identity Version> -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Revenant Theme Studio</Product>
    <AssemblyTitle>Revenant Theme Studio</AssemblyTitle>
    <Company>Revenant Systems LLC</Company>
    <Authors>Revenant Systems LLC</Authors>
    <Copyright>Copyright © 2026 Revenant Systems LLC</Copyright>
    <Description>Windows 11 theme manager: custom folder, drive, and system icons with consent-gated, fully reversible changes.</Description>
    <!--
      Exclude Claude Code agent scratch directories from EVERY default item
      glob (Compile, Page, Resource, ApplicationDefinition, None, Embedded-
      Resource, ...). DefaultItemExcludes is an MSBuild property — unlike
      per-item <Remove/> entries, it's inherited by WPF's MarkupCompilePass1
      _wpftmp.csproj. Without this, any leftover worktree under
      .claude\worktrees\ gets re-globbed by the WPF temp project and
      poisons the build with stale duplicates of services/views.

      Keep this here even when no worktrees are present — agent runs may
      drop new ones in at any time and this makes the project bulletproof.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.claude\**;RTS.MunWriter\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="BuildAndCopyMunWriter" AfterTargets="Build">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)RTS.MunWriter\RTS.MunWriter.csproj&quot; -c $(Configuration) -r win-x64 --no-self-contained" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RTS.MunWriter\bin\$(Configuration)\net8.0-windows\win-x64\RTS.MunWriter.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <Compile Remove="IconEngine\**\*" />
    <None Remove="Assets\rts_app.ico" />
    <!-- Branding assets — embedded as WPF pack resources (exclude large model files) -->
    <Resource Include="Assets\**\*" Exclude="Assets\Models\**" />
    <!-- ONNX models ship alongside the exe, not embedded -->
    <Content Include="Assets\Models\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

</Project>
