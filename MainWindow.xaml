<Window x:Class="Revenant_Theme_Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Revenant_Theme_Studio.ViewModels"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Revenant Theme Studio"
        Height="900"
        Width="1340"
        Background="#15181B"
        Foreground="#EAEAEA"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/IconEngine/icons/Logos/RTS2.ico">

    <Window.Resources>

		<!-- ===== Palette ===== -->
		<SolidColorBrush x:Key="TextBrush" Color="#F0F0F0"/>
		<SolidColorBrush x:Key="MutedTextBrush" Color="#B8B8B8"/>
		<SolidColorBrush x:Key="GoldBrush" Color="#D4AF37"/>
		<SolidColorBrush x:Key="GoldBrightBrush" Color="#FFD700"/>
		<SolidColorBrush x:Key="PanelBorderBrush" Color="#5A5A5A"/>
		<SolidColorBrush x:Key="TileBorderBrush" Color="#4A4A4A"/>
		<SolidColorBrush x:Key="DropDownBackgroundBrush" Color="#1F2327"/>
		<SolidColorBrush x:Key="DropDownBorderBrush" Color="#D4AF37"/>
		<SolidColorBrush x:Key="DropDownItemHoverBrush" Color="#2E343A"/>
		<SolidColorBrush x:Key="DropDownItemSelectedBrush" Color="#5A4716"/>
		
		<!-- Metallic gold for headings -->
		<LinearGradientBrush x:Key="GoldMetalBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#6E5710" Offset="0.00"/>
			<GradientStop Color="#C9A23A" Offset="0.35"/>
			<GradientStop Color="#FFF1A8" Offset="0.50"/>
			<GradientStop Color="#C9A23A" Offset="0.65"/>
			<GradientStop Color="#5B4708" Offset="1.00"/>
		</LinearGradientBrush>

		<!-- Main panel surfaces -->
		<LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#4A4F55" Offset="0.00"/>
			<GradientStop Color="#34383D" Offset="0.35"/>
			<GradientStop Color="#23272B" Offset="0.65"/>
			<GradientStop Color="#15181B" Offset="1.00"/>
		</LinearGradientBrush>

		<!-- Inputs -->
		<LinearGradientBrush x:Key="InputBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#2A2A2A" Offset="0.00"/>
			<GradientStop Color="#202020" Offset="1.00"/>
		</LinearGradientBrush>

		<!-- Buttons -->
		<LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#373737" Offset="0.00"/>
			<GradientStop Color="#292929" Offset="0.50"/>
			<GradientStop Color="#1E1E1E" Offset="1.00"/>
		</LinearGradientBrush>

		<LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#444444" Offset="0.00"/>
			<GradientStop Color="#333333" Offset="0.50"/>
			<GradientStop Color="#262626" Offset="1.00"/>
		</LinearGradientBrush>

		<!-- Icon tiles -->
		<LinearGradientBrush x:Key="TileBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#3A3A3A" Offset="0.00"/>
			<GradientStop Color="#2B2B2B" Offset="0.50"/>
			<GradientStop Color="#202020" Offset="1.00"/>
		</LinearGradientBrush>

		<LinearGradientBrush x:Key="TileSelectedBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#4A4030" Offset="0.00"/>
			<GradientStop Color="#3A3124" Offset="0.50"/>
			<GradientStop Color="#2A2218" Offset="1.00"/>
		</LinearGradientBrush>

		<!-- ===== Styles ===== -->
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
		</Style>

		<Style TargetType="TextBox">
			<Setter Property="Background" Value="{StaticResource InputBrush}"/>
			<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
		</Style>

		<Style TargetType="ComboBox">
			<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
			<Setter Property="Background" Value="{StaticResource PanelBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<Border x:Name="MainBorder"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="4">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="32"/>
									</Grid.ColumnDefinitions>

									<ContentPresenter Margin="8,3,4,3"
													  VerticalAlignment="Center"
													  HorizontalAlignment="Left"
													  Content="{TemplateBinding SelectionBoxItem}"
													  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

									<Border Grid.Column="1"
											Background="#2A2F34"
											BorderBrush="{TemplateBinding BorderBrush}"
											BorderThickness="1,0,0,0">
										<Path HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Fill="{StaticResource GoldBrush}"
											  Data="M 0 0 L 4 4 L 8 0 Z"/>
									</Border>
								</Grid>
							</Border>

							<Popup x:Name="Popup"
								   Placement="Bottom"
								   IsOpen="{TemplateBinding IsDropDownOpen}"
								   AllowsTransparency="True"
								   Focusable="False"
								   PopupAnimation="Slide">
								<Border Background="{StaticResource DropDownBackgroundBrush}"
										BorderBrush="{StaticResource DropDownBorderBrush}"
										BorderThickness="1"
										CornerRadius="4"
										Padding="2">
									<ScrollViewer CanContentScroll="True"
												  SnapsToDevicePixels="True">
										<ItemsPresenter/>
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
							</Trigger>
							<Trigger Property="IsKeyboardFocusWithin" Value="True">
								<Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		
		<Style TargetType="ComboBoxItem">
			<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
			<Setter Property="Background" Value="{StaticResource DropDownBackgroundBrush}"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBoxItem">
						<Border x:Name="ItemBorder"
								Background="{TemplateBinding Background}"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DropDownItemHoverBrush}"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DropDownItemSelectedBrush}"/>
								<Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="Button">
			<Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
			<Setter Property="Background" Value="{StaticResource PanelBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Border"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="4"
								SnapsToDevicePixels="True">
							<Grid>
								<Rectangle Height="18"
										   VerticalAlignment="Top"
										   IsHitTestVisible="False"
										   Opacity="0.10">
									<Rectangle.Fill>
										<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
											<GradientStop Color="#FFFFFF" Offset="0.00"/>
											<GradientStop Color="#00FFFFFF" Offset="1.00"/>
										</LinearGradientBrush>
									</Rectangle.Fill>
								</Rectangle>

								<ContentPresenter HorizontalAlignment="Center"
												  VerticalAlignment="Center"
												  Margin="8,3"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Border" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
								<Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Border" Property="Background" Value="#151515"/>
								<Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.55"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="TabControl">
			<Setter Property="Background" Value="{StaticResource PanelBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style TargetType="TabItem">
			<Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
			<Setter Property="Background" Value="{StaticResource InputBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="12,4"/>
			<Setter Property="Margin" Value="0,0,2,0"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabItem">
						<Border x:Name="Border"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="4,4,0,0"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  ContentSource="Header"/>
						</Border>

						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
								<Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
							</Trigger>

							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Border" Property="Background" Value="#5A4716"/>
								<Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
								<Setter Property="Foreground" Value="#111111"/>
							</Trigger>

							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
				<GradientStop Color="#5A6067" Offset="0.00"/>
				<GradientStop Color="#3B4046" Offset="0.18"/>
				<GradientStop Color="#262A2F" Offset="0.50"/>
				<GradientStop Color="#171A1D" Offset="0.78"/>
				<GradientStop Color="#0D0F11" Offset="1.00"/>
			</LinearGradientBrush>
		</Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Revenant Theme Studio"
				   FontSize="30"
				   FontWeight="Bold"
				   Foreground="Black"
				   Margin="-1,-1,0,0"/>

		<TextBlock Text="Revenant Theme Studio"
				   FontSize="30"
				   FontWeight="Bold"
				   Foreground="Black"
				   Margin="1,-1,0,0"/>

		<TextBlock Text="Revenant Theme Studio"
				   FontSize="30"
				   FontWeight="Bold"
				   Foreground="Black"
				   Margin="-1,1,0,0"/>

		<TextBlock Text="Revenant Theme Studio"
				   FontSize="30"
				   FontWeight="Bold"
				   Foreground="Black"
				   Margin="1,1,0,0"/>

		<!-- main gold text -->
		<TextBlock Text="Revenant Theme Studio"
				   FontSize="30"
				   FontWeight="Bold"
				   Foreground="{StaticResource GoldMetalBrush}"/>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="1">

            <!-- ================= ICON TAB ================= -->
            <TabItem Header="Folder Icons">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ICON LIBRARY -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock Text="Icon Library:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="650" Text="{Binding IconFolder}"/>
                        <Button Content="Browse" Click="BrowseIconFolder_Click"/>
                    </StackPanel>

                    <!-- TARGET -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="Selected Folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="650" Text="{Binding SelectedFolder}"/>
                        <Button Content="Browse" Click="BrowseTargetFolder_Click"/>
                    </StackPanel>

                    <!-- ICON GRID -->
                    <Border Grid.Row="2" Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Icon Library"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldMetalBrush}"/>

                            <ListBox Height="430"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding IconList}"
                                     SelectedItem="{Binding SelectedIcon}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Tile"
                                                            Background="{StaticResource PanelBrush}"
                                                            BorderBrush="{StaticResource TileBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                                            <Setter TargetName="Tile" Property="Background" Value="#232323"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileSelectedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="84">
                                            <Image Width="48"
                                                   Height="48"
                                                   Margin="0,4"
                                                   Source="{Binding PreviewImage}"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT PANEL -->
                    <Border Grid.Row="2" Grid.Column="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            Padding="8"
                            Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Current Icon"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldMetalBrush}"/>

                            <TextBlock Text="{Binding CurrentFolderIconReference}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>

                            <Image Width="96"
                                   Height="96"
                                   Margin="0,8"
                                   Source="{Binding SelectedIcon.PreviewImage}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply" Width="140" Click="ApplyFolderIcon_Click"/>
                                <Button Content="Undo / Restore" Width="180" Click="UndoLastChange_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= WALLPAPER TAB ================= -->
            <TabItem Header="Wallpaper">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Render Mode:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="180"
                                  ItemsSource="{Binding Wallpaper.RenderModes}"
                                  SelectedItem="{Binding Wallpaper.SelectedRenderMode}"/>

                        <TextBlock Text="Span Behavior:" VerticalAlignment="Center" Margin="20,0,8,0"/>
                        <ComboBox Width="180"
                                  ItemsSource="{Binding Wallpaper.SpanBehaviors}"
                                  SelectedItem="{Binding Wallpaper.SelectedSpanBehavior}"/>

                        <Button Content="Refresh Displays"
                                Margin="20,0,0,0"
                                Click="RefreshDisplays_Click"/>
                    </StackPanel>

                    <!-- DISPLAY -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,8,0">
                        <Canvas Width="760" Height="420" Background="#121212">
                            <ItemsControl ItemsSource="{Binding Wallpaper.DisplaySlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <primitives:Thumb DragDelta="DisplayThumb_DragDelta"
                                                          Tag="{Binding SlotId}"
                                                          Width="{Binding Width}"
                                                          Height="{Binding Height}">
                                            <primitives:Thumb.Template>
                                                <ControlTemplate TargetType="primitives:Thumb">
                                                    <Border Background="{StaticResource TileBrush}"
                                                            BorderBrush="{StaticResource GoldBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="Drag to reposition"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </primitives:Thumb.Template>
                                        </primitives:Thumb>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>

                    <!-- ASSIGN -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="Assignment"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldMetalBrush}"/>

                            <ComboBox Margin="0,8,0,0"
                                      ItemsSource="{Binding Wallpaper.DisplaySlots}"
                                      SelectedItem="{Binding Wallpaper.SelectedSlot}"
                                      DisplayMemberPath="Label"/>

                            <TextBlock Text="Local Folder Source" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="220"
                                         Text="{Binding Wallpaper.LocalSourcePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Browse" Click="BrowseWallpaperSource_Click"/>
                            </StackPanel>

                            <Button Content="Assign to Slot"
                                    Margin="0,8,0,0"
                                    Width="140"
                                    Click="AssignWallpaperSource_Click"/>

                            <Button Content="Run Rotation Tick"
                                    Margin="0,8,0,0"
                                    Width="160"
                                    Click="RunRotationTick_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- STATUS -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding Wallpaper.StatusMessage}" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>