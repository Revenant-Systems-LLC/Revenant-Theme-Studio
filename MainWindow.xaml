<Window x:Class="Revenant_Theme_Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Revenant_Theme_Studio.ViewModels"
        Title="Revenant Theme Studio"
        Height="860"
        Width="1320"
        Background="#0D0D0D"
        Foreground="#FFD700"
        WindowStartupLocation="CenterScreen"
        Icon="IconEngine/icons/Logos/_Damien_ICON.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>


        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD700"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Revenant Theme Studio" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Folder Icons">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Icon Library:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="640" Text="{Binding IconFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Browse" Click="BrowseIconFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                        <CheckBox Content="Include Windows system icons" IsChecked="{Binding IncludeSystemIcons}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Width="500" Text="{Binding SystemResourcePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IncludeSystemIcons}"/>
                        <Button Content="Browse" Click="BrowseSystemResource_Click" IsEnabled="{Binding IncludeSystemIcons}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="Selected Folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="640" Text="{Binding SelectedFolder}" IsReadOnly="True"/>
                        <Button Content="Browse" Click="BrowseTargetFolder_Click"/>
                    </StackPanel>

                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Icon Library" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding IconList}" SelectedItem="{Binding SelectedIcon}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="96" Margin="6" HorizontalAlignment="Center">
                                            <Image Width="42" Height="42" Source="{Binding PreviewImage}" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock Text="Icon Library:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="650" Text="{Binding IconFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Browse" Margin="8,0,0,0" Click="BrowseIconFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="Selected Folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="650" Text="{Binding SelectedFolder}" IsReadOnly="True"/>
                        <Button Content="Browse" Margin="8,0,0,0" Click="BrowseTargetFolder_Click"/>
                    </StackPanel>

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Icon Library" FontWeight="Bold"/>
                            <ListBox Height="430" ItemsSource="{Binding IconList}" SelectedItem="{Binding SelectedIcon}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="80" Margin="4">
                                            <Image Width="42" Height="42" Source="{Binding PreviewImage}"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Selected Folder" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedFolder}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Current Icon" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentFolderIconReference}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="New Icon" FontWeight="Bold"/>
                            <Image Width="96" Height="96" Source="{Binding SelectedIcon.PreviewImage}" Margin="0,6,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply" Width="140" Click="ApplyFolderIcon_Click"/>
                                <Button Content="Undo / Restore" Width="180" Margin="8,0,0,0" Click="UndoLastChange_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Drive Icons">
                <StackPanel Margin="12">
                    <TextBlock Text="Drive Letter (for example C:)"/>
                    <TextBox Width="120" Text="{Binding SelectedDrive}"/>
                    <TextBlock Text="Current Icon" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentDriveIconReference}" TextWrapping="Wrap"/>
                    <TextBlock Text="New Icon" FontWeight="Bold" Margin="0,8,0,0"/>
                    <Image Width="96" Height="96" Source="{Binding SelectedIcon.PreviewImage}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Apply" Width="140" Click="ApplyDriveIcon_Click"/>
                        <Button Content="Undo / Restore" Width="180" Margin="8,0,0,0" Click="UndoLastChange_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Auto Match">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Scan Root"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="500" Text="{Binding ScanRoot}"/>
                            <Button Content="Browse" Margin="8,0,0,0" Click="BrowseScanRoot_Click"/>
                        </StackPanel>
                        <TextBlock Text="Matching Mode: Strict (conservative)" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Run Auto Match" Width="160" Click="RunAutoMatch_Click"/>
                            <Button Content="Cancel" Width="110" Margin="8,0,0,0" Click="CancelAutoMatch_Click"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AutoProgressText}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <GroupBox Header="Applied Automatically" Margin="0,0,0,6">
                            <ListBox ItemsSource="{Binding AppliedAutomatically}" DisplayMemberPath="FolderName"/>
                        </GroupBox>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <GroupBox Header="Our Best Guess" Margin="0,0,4,0"><ListBox ItemsSource="{Binding OurBestGuess}" DisplayMemberPath="FolderName"/></GroupBox>
                            <GroupBox Grid.Column="1" Header="Used Default Icon" Margin="4,0,4,0"><ListBox ItemsSource="{Binding UsedDefaultIcon}" DisplayMemberPath="FolderName"/></GroupBox>
                            <GroupBox Grid.Column="2" Header="Skipped" Margin="4,0,0,0"><ListBox ItemsSource="{Binding Skipped}" DisplayMemberPath="FolderName"/></GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Restore">
                <StackPanel Margin="12">
                    <TextBlock Text="Undo Last Change" FontWeight="Bold"/>
                    <Button Content="Undo Last Change" Width="180" Margin="0,8,0,0" Click="UndoLastChange_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Advanced">
                <StackPanel Margin="12">
                    <TextBlock Text="Special Explorer / shell icons (per-user HKCU overrides)" FontWeight="Bold"/>
                    <ComboBox Width="280" Margin="0,8,0,0" ItemsSource="{Binding ShellTargets}" SelectedItem="{Binding SelectedShellTarget}"/>
                    <TextBlock Text="Current Icon" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentShellIconReference}" TextWrapping="Wrap"/>
                    <TextBlock Text="New Icon" FontWeight="Bold" Margin="0,8,0,0"/>
                    <Image Width="96" Height="96" Source="{Binding SelectedIcon.PreviewImage}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Apply" Width="140" Click="ApplyShellIcon_Click"/>
                        <Button Content="Restore Default" Width="140" Margin="8,0,0,0" Click="RestoreShellDefault_Click"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AdvancedNote}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Help">
                <TextBlock Margin="12" TextWrapping="Wrap"
                           Text="RTS is designed to be conservative: exact/safe matches are applied automatically; weak matches are not. Use Restore to undo changes. Advanced features are fenced and use HKCU overrides by default."/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}"/>
        </Border>
    </Grid>
</Window>
