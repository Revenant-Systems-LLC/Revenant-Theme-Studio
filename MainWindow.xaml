<Window x:Class="Revenant_Theme_Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Revenant_Theme_Studio.ViewModels"
        xmlns:converters="clr-namespace:Revenant_Theme_Studio.Converters"
        Title="Revenant Theme Studio"
        Height="860"
        Width="1360"
        Background="#0D0D0D"
        Foreground="#FFD700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style x:Key="FrameBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="OvalActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#1A1A1A" Stroke="#FFD700" StrokeThickness="3"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FrameBorderStyle}">
            <TextBlock Text="RTS - ICON EDITOR UIX" FontSize="34" FontFamily="Segoe UI Black"/>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="6" FontSize="16" Background="#0D0D0D" BorderThickness="0">
            <TabItem Header="INTRO SCREEN">
                <Grid Background="#0D0D0D" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="560"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1" Style="{StaticResource FrameBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#FFD700" BorderThickness="3" Padding="10" Margin="0,0,0,16">
                                <TextBlock Text="RTS" FontSize="42" FontFamily="Segoe Script" HorizontalAlignment="Center"/>
                            </Border>

                            <UniformGrid Grid.Row="1" Columns="2" Rows="6" Margin="50,10,50,10">
                                <Button Content="folder-icons" Click="IntroNavigate_Click" Tag="1"/>
                                <Button Content="system icons" Click="IntroNavigate_Click" Tag="2"/>
                                <Button Content="drive icons" Click="IntroNavigate_Click" Tag="3"/>
                                <Button Content="registry edits" Click="IntroNavigate_Click" Tag="3"/>
                                <Button Content="icon editor" Click="IntroNavigate_Click" Tag="2"/>
                                <Button Content="dual screen" IsEnabled="False"/>
                                <Button Content="icon-logos" IsEnabled="False"/>
                                <Button Content="themes" IsEnabled="False"/>
                                <Button Content="wallpapers" IsEnabled="False"/>
                                <Button Content="resource mngr" IsEnabled="False"/>
                                <Button Content="help/support" IsEnabled="False"/>
                                <Button Content="settings" IsEnabled="False"/>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="FOLDER + DRIVE ICONS">
                <Grid Background="#0D0D0D" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FrameBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="FOLDER ICONS"/>
                                <Button Grid.Column="1" Content="MANUAL"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding IconFolder, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                <Button Grid.Column="1" Content="..." Width="60" Click="BrowseIconFolder_Click"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="..." Width="60" Click="BrowseTargetFolder_Click"/>
                            </Grid>

                            <ListBox Grid.Row="3" Margin="0,10,0,8" ItemsSource="{Binding IconList}" SelectedItem="{Binding SelectedIcon, Mode=TwoWay}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="90" Margin="4">
                                            <Image Width="50" Height="50" Source="{Binding PreviewImage}"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="4" BorderBrush="#FFD700" BorderThickness="3" Padding="8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedIcon.DisplayName, TargetNullValue=intended icon to be changed}" FontSize="20" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center"/>
                            </Border>

                            <Button Grid.Row="5" Content="APPLY" Style="{StaticResource OvalActionButton}" HorizontalAlignment="Center" Click="ApplyManual_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FrameBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="DRIVE ICONS"/>
                                <Button Grid.Column="1" Content="AUTO"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ScanRoot, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                                <Button Grid.Column="1" Content="..." Width="60" Click="BrowseScanRoot_Click" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                            </Grid>

                            <Border Grid.Row="2" BorderBrush="#FFD700" BorderThickness="3" Padding="10" Margin="0,10,0,8">
                                <StackPanel>
                                    <TextBlock Text="Match Threshold (Levenshtein)" FontFamily="Segoe UI Semibold" FontSize="18"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Slider Minimum="0" Maximum="6" Value="{Binding MatchThreshold, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" Width="280" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                                        <TextBlock Text="{Binding MatchThreshold}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AutoProgressText}" Foreground="#BBBBBB" Margin="0,8,0,0"/>
                                    <TextBlock Text="Accept warning page to unlock auto mode." Foreground="#BBBBBB"/>
                                    <ProgressBar Height="16" Margin="0,8,0,0" IsIndeterminate="{Binding IsAutoRunning}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" BorderBrush="#FFD700" BorderThickness="3" Padding="8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedIcon.DisplayName, TargetNullValue=intended icon to be changed / drive select}" FontSize="20" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="RUN AUTO" Style="{StaticResource OvalActionButton}" Click="RunAutoMatch_Click" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                                <Button Grid.Column="1" Content="CANCEL" Style="{StaticResource OvalActionButton}" Click="CancelAutoMatch_Click" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="ICON EDITOR">
                <Grid Background="#0D0D0D" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding IconFolder, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                        <Button Grid.Column="1" Content="..." Width="60" Click="BrowseIconFolder_Click"/>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="1" Margin="8,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SelectedIcon.DisplayName, TargetNullValue=intended icon being changed}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="..." Width="60" IsEnabled="False"/>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,4,8,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SystemResourcePath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="..." Width="60" Click="BrowseSystemResource_Click"/>
                    </Grid>

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#FFD700" BorderThickness="3" Padding="8" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ListBox Grid.Row="0" ItemsSource="{Binding IconList}" SelectedItem="{Binding SelectedIcon, Mode=TwoWay}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="74" Margin="4">
                                            <Image Width="40" Height="40" Source="{Binding PreviewImage}"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1" Text="users icon folder" FontSize="16" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#FFD700" BorderThickness="3" Padding="8" Margin="8,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" Stretch="Uniform">
                                <Border BorderBrush="#FFD700" BorderThickness="3" CornerRadius="20" Padding="20" Background="#1A1A1A">
                                    <Image Width="260" Height="260" Source="{Binding SelectedIcon.PreviewImage}"/>
                                </Border>
                            </Viewbox>
                            <TextBlock Grid.Row="1" Text="selected icon zoomed in" FontSize="16" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" BorderBrush="#FFD700" BorderThickness="3" Padding="10" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="BATCH EDIT OPTIONS" FontSize="24" FontFamily="Segoe UI Black" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                            <TextBlock Text="ALL" FontFamily="Segoe UI Semibold" Margin="0,2"/>
                            <TextBlock Text="SOME" FontFamily="Segoe UI Semibold" Margin="0,2"/>
                            <TextBlock Text="Current build keeps editor tools as preview-only UI." Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,8,0,16"/>
                            <Button Content="RELOAD ICONS" Click="ReloadIconLibrary_Click"/>
                            <Button Content="APPLY TO FOLDER" Click="ApplyManual_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="WARNING + AUTO">
                <Grid Background="#0D0D0D" Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FrameBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#FFD700" BorderThickness="3" Padding="12" Margin="0,0,0,10">
                                <TextBlock Text="WARNING PAGE LAYOUT" FontFamily="Segoe UI Black" FontSize="44" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="1" BorderBrush="#FFD700" BorderThickness="3" Padding="14" Margin="0,0,0,10">
                                <TextBlock FontSize="30" FontFamily="Segoe UI Semibold" TextWrapping="Wrap"
                                           Text="Very clear and very blunt warning here about using any of the registry editing features. We will automatically back up a snapshot as soon as user accepts responsibility below."/>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="ACCEPT" Style="{StaticResource OvalActionButton}" Click="AcceptWarning_Click"/>
                                <Button Grid.Column="1" Content="DENY" Style="{StaticResource OvalActionButton}" Click="DenyWarning_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FrameBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#FFD700" BorderThickness="3" Padding="8" Margin="0,0,0,10">
                                <TextBlock Text="!AUTO!" FontSize="46" FontFamily="Segoe Script" HorizontalAlignment="Center"/>
                            </Border>

                            <TextBox Grid.Row="1" Text="{Binding ScanRoot, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                            <TextBox Grid.Row="2" Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                            <TextBox Grid.Row="3" Text="{Binding IconFolder, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding IsAutoWarningAccepted}"/>

                            <StackPanel Grid.Row="4" Margin="0,8,0,8">
                                <TextBlock Text="Levenshtein threshold" FontSize="22" FontFamily="Segoe UI Black"/>
                                <Slider Minimum="0" Maximum="6" Value="{Binding MatchThreshold, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                                <TextBlock Text="{Binding MatchThreshold}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding AutoProgressText}" Foreground="#BBBBBB" Margin="0,8,0,0"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="5" Height="18" IsIndeterminate="{Binding IsAutoRunning}" Margin="0,0,0,12"/>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="DRY RUN" Style="{StaticResource OvalActionButton}" IsEnabled="False"/>
                                <Button Grid.Column="1" Content="RUN AUTO" Style="{StaticResource OvalActionButton}" Click="RunAutoMatch_Click" IsEnabled="{Binding IsAutoWarningAccepted}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="#FFD700" BorderThickness="3" Background="#111111" Padding="10" Margin="6,8,6,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontFamily="Segoe UI Semibold"/>
        </Border>
    </Grid>
</Window>
