<Window x:Class="Revenant_Theme_Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Revenant_Theme_Studio.ViewModels"
        xmlns:converters="clr-namespace:Revenant_Theme_Studio.Converters"
        Title="Revenant Theme Studio" Height="760" Width="1200"
        Background="#0D0D0D" Foreground="#FFD700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="REVENANT THEME STUDIO"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#FFD700"
                       FontFamily="Segoe UI"/>
            <TextBlock Text="Folder and System Icon Manager"
                       FontSize="12" Foreground="#888888"
                       FontFamily="Segoe UI"/>
            <Separator Background="#FFD700" Margin="0,8,0,0" Height="1"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="Icon Library:" VerticalAlignment="Center" Width="130"/>
            <TextBox Width="540"
                     Text="{Binding IconFolder, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
            <Button Content="Browse" Margin="8,0,0,0" Click="BrowseIconFolder_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Label Content="System Resource:" VerticalAlignment="Center" Width="130"/>
            <TextBox Width="540"
                     Text="{Binding SystemResourcePath, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
            <Button Content="Browse .mun" Margin="8,0,0,0" Click="BrowseSystemResource_Click"/>
            <Button Content="Load Icons" Margin="8,0,0,0" Click="ReloadIconLibrary_Click"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FFD700" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="MANUAL MODE" FontWeight="Bold" FontSize="14"
                               Foreground="#FFD700" Margin="0,0,0,12"/>

                    <Label Content="Target Folder:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Click="BrowseTargetFolder_Click"/>
                    </Grid>

                    <Label Content="Select Icon (Library + imageres.dll.mun):" Margin="0,12,0,0"/>

                    <ListBox ItemsSource="{Binding IconList}"
                             SelectedItem="{Binding SelectedIcon, Mode=TwoWay}"
                             Height="390"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="110" Margin="4" ToolTip="{Binding DisplayName}">
                                    <Image Width="72" Height="72" Stretch="Uniform" Source="{Binding PreviewImage}"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#FFD700"
                                               FontSize="10"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="100"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border BorderBrush="#FFD700" BorderThickness="1" Margin="0,12,0,0" Padding="8" Height="120">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="96" Height="96" Stretch="Uniform"
                                   Source="{Binding SelectedIcon.PreviewImage}"
                                   VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Selected:"
                                           Foreground="#888888"
                                           FontSize="11"/>
                                <TextBlock Text="{Binding SelectedIcon.DisplayName}"
                                           Foreground="#FFD700"
                                           FontSize="14"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Apply Icon" Margin="0,12,0,0" Click="ApplyManual_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#FFD700" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="AUTO MODE" FontWeight="Bold" FontSize="14"
                               Foreground="#FFD700" Margin="0,0,0,12"/>

                    <Label Content="Scan Root Folder:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding ScanRoot, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Click="BrowseScanRoot_Click"/>
                    </Grid>

                    <Label Content="Match Threshold (Levenshtein):" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="0" Maximum="6"
                                Value="{Binding MatchThreshold, Mode=TwoWay}"
                                Width="200" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock Text="{Binding MatchThreshold}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Run Auto-Match" Margin="0,12,0,0"
                            Click="RunAutoMatch_Click"
                            IsEnabled="{Binding IsAutoRunning, Converter={StaticResource InverseBooleanConverter}}"/>

                    <Button Content="Cancel" Margin="0,8,0,0"
                            Click="CancelAutoMatch_Click"
                            IsEnabled="{Binding IsAutoRunning}"/>

                    <ProgressBar Height="14" Margin="0,12,0,0"
                                 IsIndeterminate="{Binding IsAutoRunning}"/>

                    <TextBlock Text="{Binding AutoProgressText}" Margin="0,6,0,0"
                               Foreground="#888888"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" BorderBrush="#FFD700" BorderThickness="1"
                Margin="0,12,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FFD700" FontSize="12"/>
        </Border>
    </Grid>
</Window>
