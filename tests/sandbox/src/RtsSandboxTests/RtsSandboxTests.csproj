<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test harness that runs inside Windows Sandbox. Published self-contained into
       tests\sandbox\kit\tests because the sandbox has no .NET runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests drive Theme Studio's own services, built from the current working tree. -->
    <Reference Include="Revenant-Theme-Studio">
      <HintPath>..\..\..\..\bin\Debug\net8.0-windows\Revenant-Theme-Studio.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
