<UserControl x:Class="Revenant_Theme_Studio.Features.Personalization.Views.PersonalizationHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Revenant_Theme_Studio.Features.Personalization.Views"
             xmlns:wpv="clr-namespace:Revenant_Theme_Studio.Features.Wallpaper.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One Settings-style navigation row -->
        <Style x:Key="SectionRow" TargetType="Border">
            <Setter Property="Background" Value="#55000a05"/>
            <Setter Property="BorderBrush" Value="#00422a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7a001510"/>
                    <Setter Property="BorderBrush" Value="#C4962B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,10">
            <TextBlock FontFamily="Consolas" FontSize="20" FontWeight="Bold" Cursor="Hand"
                       MouseLeftButtonUp="Home_Click">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#7a5e30"/>
                        <Setter Property="Text" Value="Personalization"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHome}" Value="True">
                                <Setter Property="Foreground" Value="#C4962B"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C4962B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text=" › " FontFamily="Consolas" FontSize="20" Foreground="#6B5820"
                       Visibility="{Binding IsHome, Converter={x:Static views:InverseBoolToVis.Instance}}"/>
            <TextBlock Text="{Binding BreadcrumbSection}" FontFamily="Consolas" FontSize="20"
                       FontWeight="Bold" Foreground="#C4962B"
                       Visibility="{Binding IsHome, Converter={x:Static views:InverseBoolToVis.Instance}}"/>
        </StackPanel>

        <!-- ═══════════ Landing ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="4,0,12,20">

                <!-- Preview card -->
                <Border Background="#22000000" BorderBrush="#00422a" BorderThickness="1"
                        Padding="14" Margin="0,0,0,16" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="300" Height="168" Background="#11000000"
                                BorderBrush="#00422a" BorderThickness="1">
                            <Image Source="{Binding CurrentWallpaperPath}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Margin="16,4,4,0" VerticalAlignment="Top">
                            <TextBlock Text="CURRENT DESKTOP" FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="#6B5820" FontSize="12"/>
                            <TextBlock Text="{Binding Background.MonitorSummary}" FontFamily="Consolas"
                                       FontSize="12" Foreground="#A88E5E" Margin="0,6,0,0"
                                       TextWrapping="Wrap" MaxWidth="380"/>
                            <TextBlock Text="{Binding Colors.StatusMessage}" FontFamily="Consolas"
                                       FontSize="11" Foreground="#66888888" Margin="0,6,0,0"
                                       TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section rows -->
                <Border Style="{StaticResource SectionRow}" MouseLeftButtonUp="Background_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE91B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" Foreground="#C4962B" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Background" FontFamily="Consolas" FontSize="14" Foreground="#C4962B"/>
                            <TextBlock Text="Pinterest and gallery sourcing, per-monitor layout canvas, AI upscale, rotation"
                                       FontFamily="Consolas" FontSize="11" Foreground="#66888888"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="#6B5820" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionRow}" MouseLeftButtonUp="Display_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" Foreground="#C4962B" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Display" FontFamily="Consolas" FontSize="14" Foreground="#C4962B"/>
                            <TextBlock Text="Resolution, refresh rate, orientation per monitor — with a safe auto-revert"
                                       FontFamily="Consolas" FontSize="11" Foreground="#66888888"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="#6B5820" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionRow}" MouseLeftButtonUp="Colors_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE790;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22" Foreground="#C4962B" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Colors" FontFamily="Consolas" FontSize="14" Foreground="#C4962B"/>
                            <TextBlock Text="Dark/light mode, transparency, accent color — consent-gated, backed up, reversible"
                                       FontFamily="Consolas" FontSize="11" Foreground="#66888888"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="#6B5820" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Text="Coming to this hub: custom DPI/scale overrides and color calibration (normal + wide gamut)."
                           FontFamily="Consolas" FontSize="11" Foreground="#446B5820" Margin="4,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ Sections (instantiated once, shown by nav state) ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHome}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <wpv:WallpaperView DataContext="{Binding Background}">
                <wpv:WallpaperView.Style>
                    <Style TargetType="wpv:WallpaperView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Value="Background"
                                         Binding="{Binding DataContext.Current,
                                          RelativeSource={RelativeSource AncestorType=views:PersonalizationHubView}}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </wpv:WallpaperView.Style>
            </wpv:WallpaperView>

            <views:DisplayView DataContext="{Binding Display}">
                <views:DisplayView.Style>
                    <Style TargetType="views:DisplayView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Value="Display"
                                         Binding="{Binding DataContext.Current,
                                          RelativeSource={RelativeSource AncestorType=views:PersonalizationHubView}}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:DisplayView.Style>
            </views:DisplayView>

            <views:ColorsView DataContext="{Binding Colors}">
                <views:ColorsView.Style>
                    <Style TargetType="views:ColorsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Value="Colors"
                                         Binding="{Binding DataContext.Current,
                                          RelativeSource={RelativeSource AncestorType=views:PersonalizationHubView}}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ColorsView.Style>
            </views:ColorsView>
        </Grid>
    </Grid>
</UserControl>
