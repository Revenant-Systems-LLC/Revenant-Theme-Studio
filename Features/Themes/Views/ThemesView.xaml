<UserControl x:Class="Revenant_Theme_Studio.Features.Themes.Views.ThemesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#C4962B" FontFamily="Consolas">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#d8b878"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#997a4c"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <Button Content="Import theme…" Click="Import_Click" IsEnabled="{Binding IsIdle}" Margin="0"
                    ToolTip="Revenant themes (.rtstheme), Windows themes (.theme, .themepack) and WinDynamicDesktop (.ddw)"/>
            <TextBox Text="{Binding CaptureName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="12,0,0,0"
                     VerticalContentAlignment="Center" ToolTip="Name for the captured theme"/>
            <Button Content="Save current look" Click="Capture_Click" IsEnabled="{Binding IsIdle}"
                    ToolTip="Captures your wallpaper, colors, and desktop and drive icons as a new theme"/>
            <Button DockPanel.Dock="Right" Content="Undo last theme" Click="Undo_Click"
                    IsEnabled="{Binding CanUndo}" ToolTip="Puts back everything the last applied theme changed"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding AppliedText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap"/>
        </DockPanel>

        <!-- ── Library and details ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#00422a" BorderThickness="1" Background="#000d07">
                <Grid>
                    <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="104" Height="64" Background="#002414" BorderBrush="#4a3a20" BorderThickness="1">
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#d8b878" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Byline}" FontSize="12" Foreground="#7a5e30" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#997a4c" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No themes yet. Import one, or save your current look." Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"
                               Visibility="{Binding Themes.Count, Converter={x:Static local:ThemesView.ZeroToVisible}}"
                               xmlns:local="clr-namespace:Revenant_Theme_Studio.Features.Themes.Views"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#00422a" BorderThickness="1" Background="#001a0e" Padding="16"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding Selected.Byline}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Selected.Origin}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding Selected.Summary}" Foreground="#C4962B" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,12" BorderBrush="#4a3a20" BorderThickness="1" Background="#000d07">
                        <Image Source="{Binding Selected.Preview}" Stretch="Uniform"/>
                    </Border>
                    <WrapPanel Grid.Row="2">
                        <Button Content="Apply theme" Style="{DynamicResource GoldButton}" Click="Apply_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"/>
                        <Button Content="Export .rtstheme…" Click="ExportBundle_Click" IsEnabled="{Binding IsIdle}"/>
                        <Button Content="Export Windows .theme…" Click="ExportTheme_Click" IsEnabled="{Binding IsIdle}"/>
                        <Button Content="Remove" Click="Remove_Click" IsEnabled="{Binding IsIdle}" Margin="16,0,0,0"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Status and report ── -->
        <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="#00422a" BorderThickness="1" Background="#000d07" Padding="10,6">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#d8b878" FontSize="13" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Report}" MaxHeight="140" Margin="0,4,0,0">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#997a4c" FontSize="12" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
