<UserControl x:Class="Revenant_Theme_Studio.Controls.IconLibraryRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!-- The rail inherits DataContext from its host (MainWindow → MainViewModel),
         so every tab that drops one in stays bound to the same SelectedIcon /
         IconList / IconFolder / SystemResourcePath / IncludeSystemIcons state.
         That's the entire point of the rail: pick once, apply on whichever tab
         you happen to be standing on. -->

    <Border Background="#55000a05" BorderBrush="#00422a" BorderThickness="1"
            Padding="10" Margin="0,0,8,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- title -->
                <RowDefinition Height="Auto"/>  <!-- icon folder picker -->
                <RowDefinition Height="Auto"/>  <!-- include-system-icons + path -->
                <RowDefinition Height="*"/>     <!-- icon list -->
                <RowDefinition Height="Auto"/>  <!-- selected preview -->
            </Grid.RowDefinitions>

            <!-- ── Title ── -->
            <TextBlock Grid.Row="0" Text="ICON LIBRARY"
                       FontFamily="Consolas" FontWeight="Bold"
                       Foreground="#C4962B" FontSize="13" Margin="0,0,0,8"/>

            <!-- ── Icon folder picker ── -->
            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="…" Width="32"
                        ToolTip="Browse for icon folder"
                        Click="BrowseIconFolder_Click"/>
                <TextBox Text="{Binding IconFolder, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Path to a folder of .ico files"/>
            </DockPanel>

            <!-- ── System-icons toggle + resource path ── -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <CheckBox Content="System icons  [Pro]"
                          IsChecked="{Binding IncludeSystemIcons}"
                          FontSize="12"/>
                <DockPanel Margin="0,4,0,0"
                           IsEnabled="{Binding IncludeSystemIcons}">
                    <Button DockPanel.Dock="Right" Content="…" Width="32"
                            ToolTip="Browse for .mun / .dll resource"
                            Click="BrowseSystemResource_Click"/>
                    <TextBox Text="{Binding SystemResourcePath, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11"/>
                </DockPanel>
            </StackPanel>

            <!-- ── Icon grid ── -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding IconList}"
                     SelectedItem="{Binding SelectedIcon}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="92" Margin="4" HorizontalAlignment="Center">
                            <Image Width="64" Height="64"
                                   Source="{Binding PreviewImage}"
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="#6B5820"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ── Selected preview ── -->
            <Border Grid.Row="4" Margin="0,8,0,0" Padding="8"
                    Background="#001a0e" BorderBrush="#00422a" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Image Width="48" Height="48"
                           Source="{Binding SelectedIcon.PreviewImage}"
                           Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SELECTED" FontFamily="Consolas"
                                   FontWeight="Bold" FontSize="10" Foreground="#6B5820"/>
                        <TextBlock Text="{Binding SelectedIcon.DisplayName}"
                                   Foreground="#C4962B" FontSize="13"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
